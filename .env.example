# Copy this file to .env once, fill the required values, and never commit .env.
# startup.ps1 loads this one file for Python, Node/Express, and the local UI.

# -----------------------------------------------------------------------------
# Python / Cognee memory
# -----------------------------------------------------------------------------
COGNEE_BACKEND=cloud
COGNEE_BASE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=replace-with-your-cognee-api-key
COGNEE_TENANT_ID=replace-with-your-tenant-id
COGNEE_DATASET_NAME=sudarshan_memory
COGNEE_MAX_RETRIES=2
COGNEE_WRITE_MAX_RETRIES=0
COGNEE_TIMEOUT_SECONDS=30
COGNEE_RETRY_BACKOFF_SECONDS=0.5

# CrewAI and local durable state
CREWAI_MODEL=openai/gpt-5.4
CREWAI_FLOW_DB_PATH=artifacts/.state/flow_states.db
CREWAI_DISABLE_TELEMETRY=true
LANGGRAPH_CHECKPOINT_DB_PATH=artifacts/.state/langgraph_checkpoints.db
SUDARSHAN_AUDIT_DB_PATH=artifacts/.state/audit_log.db
SUDARSHAN_PROGRESS_DB_PATH=artifacts/.state/progress_events.db
# T39 shared control-plane seam. Keep sqlite for local development; use redis
# when all scheduler instances share the same Redis deployment.
SUDARSHAN_CONTROL_PLANE=sqlite
SUDARSHAN_REDIS_URL=redis://localhost:6379/0
SUDARSHAN_CONTROL_PLANE_PREFIX=sudarshan:control
SUDARSHAN_RUN_QUEUE_RECLAIM_IDLE_MS=1800000
SUDARSHAN_INGESTION_QUEUE_RECLAIM_IDLE_MS=1800000
SUDARSHAN_OBSERVABILITY_DB_PATH=artifacts/.state/observability.db
SUDARSHAN_OBSERVABILITY_RETENTION_SECONDS=2592000
SUDARSHAN_TELEMETRY_ACCESS_LEVEL=RESTRICTED
SUDARSHAN_OBSERVABILITY_EXPORT_URL=
SUDARSHAN_OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=2
SUDARSHAN_OBSERVABILITY_EXPORT_TOKEN=
SUDARSHAN_LOAD_PLUGINS=false
SUDARSHAN_ARTIFACT_ROOT=artifacts
SUDARSHAN_OBJECT_STORE_MODE=local
SUDARSHAN_OBJECT_STORE_ROOT=artifacts/.state/object-store
SUDARSHAN_OBJECT_STORE_S3_BUCKET=
SUDARSHAN_OBJECT_STORE_S3_PREFIX=sudarshan/objects
SUDARSHAN_OBJECT_STORE_S3_ENDPOINT=
SUDARSHAN_OBJECT_STORE_S3_REGION=
SUDARSHAN_OBJECT_STORE_S3_SERVER_SIDE_ENCRYPTION=AES256
SUDARSHAN_OBJECT_STORE_S3_KMS_KEY_ID=
SUDARSHAN_CACHE_DB_PATH=artifacts/.state/skill_cache.db
SUDARSHAN_QUEUE_DB_PATH=artifacts/.state/run_queue.db
SUDARSHAN_MAX_CONCURRENT_RUNS=2
SUDARSHAN_RUN_LEASE_MS=900000
SUDARSHAN_MAX_ATTEMPTS=1
SUDARSHAN_RETRY_BACKOFF_MS=250

# Native staged presentation path and its durable local DAG/worker slice.
# Keep legacy until matched quality/cost/latency evaluations pass.
SUDARSHAN_PPT_FLOW=legacy
SUDARSHAN_PPT_DAG_DB_PATH=artifacts/.state/presentation_dag.db
SUDARSHAN_PPT_DAG_QUEUE_DB_PATH=artifacts/.state/presentation_dag_queue.db
SUDARSHAN_PPT_DAG_MAX_WORKERS=2
SUDARSHAN_PPT_DAG_LEASE_MS=900000
SUDARSHAN_PPT_RENDERER_VERSION=sudarshan-flowchart@1
SUDARSHAN_PPT_VISUAL_QA=true
SUDARSHAN_VIDEO_ARTIFACT_DIR=artifacts/videos
SUDARSHAN_VIDEO_MAX_PARALLEL_SCENES=4
SUDARSHAN_VIDEO_RENDERER_VERSION=native-video@2
SUDARSHAN_VIDEO_INGEST_MAX_DURATION_SECONDS=7200
SUDARSHAN_VIDEO_INGEST_MAX_VISUAL_SAMPLES=12
SUDARSHAN_VIDEO_INGEST_SAMPLE_INTERVAL_SECONDS=5
SUDARSHAN_VIDEO_INGEST_AUDIO=1
SUDARSHAN_VIDEO_INGEST_VISUAL=1
SUDARSHAN_VIDEO_MATERIAL_DIR=artifacts/video-materials
SUDARSHAN_VIDEO_MATERIAL_CACHE_DIR=artifacts/.cache/video-materials
SUDARSHAN_VIDEO_BGM_DIR=artifacts/video-bgm
SUDARSHAN_VIDEO_BURN_SUBTITLES=0
SUDARSHAN_VIDEO_ALLOW_REMOTE_MATERIAL=0
SUDARSHAN_VIDEO_MAX_MATERIAL_BYTES=262144000
SUDARSHAN_PPT_MASTER_ROOT=
SUDARSHAN_PPT_MASTER_PYTHON=
SUDARSHAN_PPT_MASTER_TIMEOUT_SECONDS=300
SUDARSHAN_PPT_MASTER_RENDERER_VERSION=ppt-master@local
# Skill package trust and sandbox policy. Built-in skills use the trusted
# profile; verified/untrusted packages require a digest signature.
SUDARSHAN_SKILL_SIGNING_KEY=
SUDARSHAN_TRUSTED_SKILL_DIGESTS=
# Production selection is container. Local is for deterministic development
# only and requires the explicit opt-in below.
SUDARSHAN_SANDBOX_MODE=container
SUDARSHAN_SANDBOX_RUNTIME=docker
SUDARSHAN_ALLOW_LOCAL_SANDBOX=false
SUDARSHAN_SANDBOX_CONTAINER_IMAGE=python:3.12-slim

# FastAPI / orchestrator / pipeline service
SUDARSHAN_API_HOST=127.0.0.1
SUDARSHAN_API_PORT=8000
# Native Harness OperationsBridge backend origin; keep this server-side route
# or authenticated gateway origin, never a Cognee Cloud URL.
SUDARSHAN_API_ORIGIN=http://localhost:8000
SUDARSHAN_API_RELOAD=false
SUDARSHAN_CORS_ORIGINS=http://localhost:4173,http://localhost:3080,http://127.0.0.1:4173,http://127.0.0.1:3080
SUDARSHAN_MAX_INGEST_BYTES=52428800
SUDARSHAN_INGESTION_QUEUE_DB_PATH=artifacts/.state/ingestion_queue.db
SUDARSHAN_INGESTION_STAGING_DIR=artifacts/.state/ingestion_sources
SUDARSHAN_MAX_CONCURRENT_INGESTIONS=2
SUDARSHAN_INGESTION_LEASE_MS=900000
SUDARSHAN_INGESTION_MAX_ATTEMPTS=2
SUDARSHAN_INGESTION_RETRY_BACKOFF_MS=500
SUDARSHAN_INGESTION_TIMEOUT_MS=0
SUDARSHAN_EVIDENCE_INDEX_DB_PATH=artifacts/.state/evidence_index.db
SUDARSHAN_INGESTION_STAGE_CACHE_DB_PATH=artifacts/.state/ingestion_stage_cache.db
SUDARSHAN_INGESTION_CACHE_TTL_SECONDS=86400
SUDARSHAN_INGESTION_MAX_FAN_OUT=64
SUDARSHAN_INGESTION_TOKEN_BUDGET=12000
SUDARSHAN_INGESTION_OCR_CALLS=64
SUDARSHAN_INGESTION_VISION_CALLS=64
SUDARSHAN_INGESTION_SUMMARY_TOKENS=8192
SUDARSHAN_INGESTION_EMBEDDING_TOKENS=8000
SUDARSHAN_INGESTION_WALL_TIME_SECONDS=300
SUDARSHAN_INGESTION_MODEL_POLICY=local-first
SUDARSHAN_INGESTION_CONFIGURATION_HASH=local-default
# Optional provider-stage retries; each retry consumes the stage budget again.
SUDARSHAN_INGESTION_OPTIONAL_STAGE_RETRIES=0
SUDARSHAN_INGESTION_RETRY_BACKOFF_SECONDS=0.25

# OpenAI is the only supported model/media provider. The DeepSeek Harness
# remains an application/MCP boundary and is not a model provider.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_VIDEO_SCRIPT_MODEL=gpt-5.4
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
# Provider health cooldown. Quota/auth failures stop repeated calls until this
# period expires; local render fallbacks remain available.
SUDARSHAN_PROVIDER_COOLDOWN_SECONDS=300
ANTV_NODE_BINARY=node
# AntV's Node SSR bridge can take ~20-30 seconds on a cold Windows start.
ANTV_RENDER_TIMEOUT_SECONDS=60
# Bound the AntV SSR call; the renderer falls back to a deterministic SVG if exceeded.
ANTV_SSR_TIMEOUT_MS=5000
ANTV_RENDERER_VERSION=antv-infographic@0.2.20
PPT_MASTER_ROOT=
PPT_MASTER_INTAKE_ENABLED=false
PPT_MASTER_INTAKE_STRICT=false
# Optional compatibility worker; leave blank for the native OpenAI/local path.
MONEYPRINTERTURBO_BASE_URL=
MONEYPRINTERTURBO_API_KEY=
MONEYPRINTERTURBO_WAIT_FOR_COMPLETION=true
MONEYPRINTERTURBO_TIMEOUT_SECONDS=30
MONEYPRINTERTURBO_POLL_INTERVAL_SECONDS=2
MONEYPRINTERTURBO_MAX_WAIT_SECONDS=1800

# -----------------------------------------------------------------------------
# Node / Express gateway and MongoDB Atlas
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sudarshan_gateway?retryWrites=true&w=majority
MONGODB_DB_NAME=sudarshan_gateway
PYTHON_API_BASE_URL=http://localhost:8000
PYTHON_API_TIMEOUT_MS=30000
PYTHON_INGEST_TIMEOUT_MS=180000

# Google Cloud Console OAuth 2.0 Web client. Use the exact callback URL below.
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Use two different random values; production requires at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
FRONTEND_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:4173,http://localhost:3080
TOKEN_LIMIT_PER_MINUTE=20000
TOKEN_LIMIT_PER_DAY=200000
REQUEST_LIMIT_PER_MINUTE=30
MAX_RESERVED_OUTPUT_TOKENS=12000
TRANSFORM_WAIT_TIMEOUT_MS=30000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Local frontend and startup orchestration
# -----------------------------------------------------------------------------
SUDARSHAN_FRONTEND_HOST=127.0.0.1
SUDARSHAN_FRONTEND_PORT=4173
SUDARSHAN_HARNESS_PORT=3080
SUDARSHAN_OPEN_BROWSER=false

# Optional override for installed runtimes. Leave blank to resolve from PATH.
UV_CACHE_DIR=.uv-cache
