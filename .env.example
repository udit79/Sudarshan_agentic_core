# Copy this file to .env and add your Cognee key locally. Never commit .env.
COGNEE_BASE_URL=http://localhost:8011
COGNEE_API_KEY=replace-with-your-cognee-api-key
# Required for Cognee Cloud; copy this from Connection Details.
COGNEE_TENANT_ID=replace-with-your-tenant-id
COGNEE_DATASET_NAME=sudarshan_memory

# Gemini Vision — used by ingestion_pipelines/extract_image.py for handwritten
# and complex image OCR.  Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY="AQ.Ab8RN6JqIuR_waoNMeIs40ZvdY95QekRbiaooEabrTvxrckm3Q"
# Reads may retry transient failures. Set to 0 for a fully conservative setup.
COGNEE_MAX_RETRIES=2
# Writes are non-idempotent at the public REST boundary; leave at 0 unless
# your deployment deduplicates the stable sudarshan_memory_id.
COGNEE_WRITE_MAX_RETRIES=0
COGNEE_TIMEOUT_SECONDS=30
COGNEE_RETRY_BACKOFF_SECONDS=0.5

# CrewAI model configuration. Use the model/provider format supported by the
# configured CrewAI LLM provider (for example, openai/<model-name>).
CREWAI_MODEL=replace-with-your-provider-model
CREWAI_FLOW_DB_PATH=artifacts/.state/flow_states.db
# Keep case content out of CrewAI's optional telemetry by default.
CREWAI_DISABLE_TELEMETRY=true

# Optional OpenAI image generation for LinkedIn visuals. Leave blank when the
# frontend will supply an image or when only the image-prompt fallback is used.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-1

# AntV Infographic SSR bridge. Override only when node is not on PATH.
ANTV_NODE_BINARY=node

# LangGraph router checkpoints. Use a shared encrypted database checkpointer
# for multi-instance production deployments.
LANGGRAPH_CHECKPOINT_DB_PATH=artifacts/.state/langgraph_checkpoints.db
